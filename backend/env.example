NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://abishekkrishnamoorthy.online,https://www.abishekkrishnamoorthy.online

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Atlas example:
# MONGODB_URI=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority

JWT_ACCESS_SECRET=change-this-development-access-secret
JWT_REFRESH_SECRET=change-this-development-refresh-secret
COOKIE_SECRET=change-this-development-cookie-secret

# Optional services
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only for `npm run seed:admin`
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-admin-password
SUPER_ADMIN_NAME=Portfolio Admin
